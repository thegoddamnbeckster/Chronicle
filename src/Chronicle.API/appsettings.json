{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=chronicle.db"
  },
  "Security": {
    "JwtSecret": "CHANGE_THIS_SECRET_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS",
    "JwtExpirationHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "RetainedLogDays": 30
  },
  "AllowedHosts": "*"
}
