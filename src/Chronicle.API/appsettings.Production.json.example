{
  "// About this file": "appsettings.Production.json ships with sane defaults already (local SQLite, session keys held in memory) -- most installs don't need this file at all. Copy this to appsettings.Production.json only if you want to override those defaults, e.g. to point at an external PostgreSQL server.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-postgres-host;Port=5432;Database=chronicle;Username=chronicle;Password=REPLACE_ME"
  },
  "Serilog": {
    "RetainedLogDays": 14
  }
}
