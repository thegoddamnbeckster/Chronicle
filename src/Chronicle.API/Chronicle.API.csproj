<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Chronicle.Services\Chronicle.Services.csproj" />
    <ProjectReference Include="..\Chronicle.Core\Chronicle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.*" />
    <PackageReference Include="Svg.Skia" Version="2.*" />
    <!-- Svg.Skia pulls in SkiaSharp transitively, which only bundles native binaries for
         Windows/macOS by default. Linux needs this explicit reference, or
         DeviceAuthController.GetQr (SkiaSharp based PNG re-encode, see its own comment for why)
         throws DllNotFoundException on any Linux deployment (confirmed directly 2026-09-02:
         self-hosted Chronicle runs via docker-compose.yml, i.e. on Linux, where this was missing
         entirely). NoDependencies avoids requiring libfontconfig/libX11 inside a minimal
         container image. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Chronicle application icon — not user-configurable -->
    <ApplicationIcon>chronicle.ico</ApplicationIcon>
    <Win32Resource></Win32Resource>
    <UserSecretsId>c969fa09-cee3-4e32-80f7-a8406e2b99ee</UserSecretsId>
    <!-- Fallback only: SetVersionFromGit below overwrites this on every build where git is
         available. Exists so a git-less build environment (e.g. a published artifact with no
         .git folder) still gets something better than the SDK's own silent "1.0.0" default.
         Per-user directive (2026-08-29): "I never want to have to hound you to make sure it's
         updated. it should just always be the current version." A manually-typed number here
         is exactly the kind of thing that goes stale — this one already had, having drifted
         from the actual latest tag (v0.9.0, 19 commits behind HEAD at the time) within the
         same session that set it. -->
    <Version>0.9.0</Version>
  </PropertyGroup>

  <!-- Derives the version actually shown in DiagnosticsController/the web app's footer from
       git itself, every build, so it can never go stale the way a manually-maintained
       Version string already proved it does. The "git describe" command walks back from HEAD
       to the nearest tag and reports how many commits past it HEAD is (e.g.
       "v0.9.0-19-g84f4f2d"), so "the current version" is always an honest reflection of the
       actual code, not a promise someone has to remember to keep. The dirty-state flag it's
       given marks uncommitted working-tree changes, relevant here since RunTestEnvironment.ps1
       runs straight from the working tree, not a clean checkout. ContinueOnError means a
       git-less environment (no .git present, e.g. some published/archived deployments) simply
       keeps the static Version fallback above instead of failing the build. -->
  <Target Name="SetVersionFromGit" BeforeTargets="CoreCompile;GetAssemblyVersion;GenerateNuspec">
    <Exec Command="git describe --tags --always --dirty"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDescribeOutput" />
      <Output TaskParameter="ExitCode" PropertyName="GitDescribeExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitDescribeExitCode)' == '0' And '$(GitDescribeOutput)' != ''">
      <!-- Strips a leading "v" (git tags here are "v0.9.0", not "0.9.0"); InformationalVersion
           is free-text and doesn't need it, and DiagnosticsController already prepends nothing. -->
      <InformationalVersion>$(GitDescribeOutput.TrimStart('v'))</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- Embed the icon so it travels with the published output -->
    <Content Include="chronicle.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
