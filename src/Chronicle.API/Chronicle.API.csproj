<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Chronicle.Services\Chronicle.Services.csproj" />
    <ProjectReference Include="..\Chronicle.Core\Chronicle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.*" />
    <PackageReference Include="Svg.Skia" Version="2.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Chronicle application icon — not user-configurable -->
    <ApplicationIcon>chronicle.ico</ApplicationIcon>
    <Win32Resource></Win32Resource>
    <UserSecretsId>c969fa09-cee3-4e32-80f7-a8406e2b99ee</UserSecretsId>
    <!-- Read by DiagnosticsController via AssemblyInformationalVersionAttribute, shown in the
         web app's own footer. With no <Version> set at all, the SDK silently defaults to
         "1.0.0", a value that never changes no matter what actually ships — functionally
         indistinguishable from a hardcoded string even though it isn't literally one in code.
         Confirmed live (2026-08-29) this had drifted from CLAUDE.md's own documented status
         ("v0.7.0 released"); this project file is the actual source of truth now, so bump it
         here going forward, matching CLAUDE.md's own status line. -->
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the icon so it travels with the published output -->
    <Content Include="chronicle.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
